MONGO_URI=mongodb://localhost:27017/
JWT_SECRET=supersecretkey
PORT=3001

# PostgreSQL 配置
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_MAX_CONNECTIONS=20
POSTGRES_SSL=false

# 重置 PostgreSQL 表结构（当修改向量维度或表结构时需要设置为 true）
# 警告：设置为 true 会导致所有数据丢失！仅在开发时临时使用
POSTGRES_RESET_TABLES=false

# 启用 PostgreSQL 存储 (设置为 true 使用 PostgreSQL，false 使用 MongoDB)
USE_POSTGRES_STORAGE=true

# Redis配置
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=

# ==================== LLM 模型配置 ====================

# LLM 绑定类型: openai, gemini, azure, local
LLM_BINDING=openai

# LLM 模型名称
LLM_MODEL=kimi-k2.5

# LLM API 地址
LLM_BINDING_HOST=https://dashscope.aliyuncs.com/compatible-mode/v1

# LLM API 密钥
LLM_BINDING_API_KEY=

# Gemini API 配置 (当 LLM_BINDING=gemini 时使用)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-1.5-flash

# OpenAI API 配置 (当 LLM_BINDING=openai 且使用官方 OpenAI 时使用)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# Azure OpenAI 配置 (当 LLM_BINDING=azure 时使用)
# AZURE_OPENAI_API_KEY=your_azure_key_here
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_MODEL=gpt-4o-mini

# 本地模型配置 (当 LLM_BINDING=local 时使用)
# LOCAL_LLM_URL=http://localhost:11434
# LOCAL_LLM_MODEL=llama3.1

# ==================== Embedding 配置 ====================

# Embedding 绑定类型: openai, gemini, azure, local, custom
EMBEDDING_BINDING=openai

# Embedding 模型名称
EMBEDDING_MODEL=xop3qwen8bembedding

# Embedding 维度 (根据实际模型调整)
# OpenAI text-embedding-3-small: 1536, text-embedding-3-large: 3072
# 讯飞 embedding 模型: 768 (必须是 32 64 128 256 512 768 1024 2048 4096 之一)
# 注意: PostgreSQL ivfflat 索引最大支持 2000 维
EMBEDDING_DIM=768

# 是否发送维度参数 (某些 API 不支持)
EMBEDDING_SEND_DIM=true

# Embedding Token 限制
EMBEDDING_TOKEN_LIMIT=8192

# Embedding API 地址
EMBEDDING_BINDING_HOST=https://maas-api.cn-huabei-1.xf-yun.com/v2

# Embedding API 密钥
EMBEDDING_BINDING_API_KEY=

# ==================== LightRAG Embedding 参数 ====================

# 每批处理的文本数量 (embedding_batch_num)
# 控制批量 embedding 时的批次大小，默认 1
# 较大的值可以提高吞吐量，但可能增加内存使用
EMBEDDING_BATCH_NUM=2

# 最大并发数 (embedding_func_max_async)
# 控制同时发起的 embedding 请求数量，默认 1
# 增加此值可以提高处理速度，但可能触发 API 速率限制
EMBEDDING_FUNC_MAX_ASYNC=10

# ==================== RAG 配置 ====================

# 默认查询模式: naive, local, global, hybrid, mix
RAG_DEFAULT_QUERY_MODE=mix

# 检索结果数量
RAG_TOP_K=10

# 相似度阈值 (0-1)
RAG_MIN_SIMILARITY_SCORE=0.5

# 文本分块大小
RAG_CHUNK_SIZE=1200

# 分块重叠大小
RAG_CHUNK_OVERLAP=100

# 最大 Token 数
RAG_MAX_TOKENS=2000

# ==================== 知识图谱配置 ====================

# 是否启用知识图谱
KNOWLEDGE_GRAPH_ENABLED=true

# 实体提取模型绑定 (可选: openai, gemini, local)
ENTITY_EXTRACTION_BINDING=openai

# 实体类型配置 (JSON 格式)
# 默认使用通用实体类型: Person, Creature, Organization, Location, Event, Concept, Method, Content, Data, Artifact, NaturalObject
ENTITY_TYPES='["Person", "Creature", "Organization", "Location", "Event", "Concept", "Method", "Content", "Data", "Artifact", "NaturalObject"]'

SUMMARY_LANGUAGE=Chinese
# ==================== Neo4j 配置 ====================

# Neo4j 连接地址 (默认: neo4j://localhost:7687)
NEO4J_URI=neo4j://localhost:7687

# Neo4j 用户名
NEO4J_USERNAME=neo4j

# Neo4j 密码
NEO4J_PASSWORD=

# Neo4j 数据库名称 (默认: neo4j)
NEO4J_DATABASE=neo4j

# 连接池大小 (默认: 100)
NEO4J_MAX_CONNECTION_POOL_SIZE=100

# 连接超时时间 (秒, 默认: 30)
NEO4J_CONNECTION_TIMEOUT=30

# 连接获取超时时间 (秒, 默认: 30)
NEO4J_CONNECTION_ACQUISITION_TIMEOUT=30

# 最大事务重试时间 (秒, 默认: 30)
NEO4J_MAX_TRANSACTION_RETRY_TIME=30

# 最大连接生命周期 (秒, 默认: 300)
NEO4J_MAX_CONNECTION_LIFETIME=300

# 存活检查超时时间 (秒, 默认: 30)
NEO4J_LIVENESS_CHECK_TIMEOUT=30

# 保持连接 (默认: true)
NEO4J_KEEP_ALIVE=true

# ==================== Rerank 配置 ====================

# 是否启用 Rerank (true/false)
RERANK_ENABLED=true

# Rerank 提供商: cohere, jina, voyage, openai, bailian/aliyun/dashscope, local
RERANK_PROVIDER=aliyun

# Cohere API 密钥 (使用 Cohere 时需要)
COHERE_API_KEY=

# Jina AI API 密钥 (使用 Jina 时需要)
JINA_API_KEY=

# Voyage AI API 密钥 (使用 Voyage 时需要)
VOYAGE_API_KEY=

# 百炼/阿里云 DashScope API 密钥 (使用百炼时需要)
BAILIAN_API_KEY=
# 或 DASHSCOPE_API_KEY=

# Rerank 模型名称 (可选，留空使用默认值)
# Cohere: rerank-english-v3.0, rerank-multilingual-v3.0
# Jina: jina-reranker-v2-base-multilingual
# Voyage: rerank-lite-1, rerank-1
# Bailian: qwen3-rerank
RERANK_MODEL=qwen3-rerank

# Rerank 返回结果数量
RERANK_TOP_K=10

# Rerank 最小分数阈值 (0-1)
RERANK_MIN_SCORE=0.1

# ==================== 其他配置 ====================

# 日志级别: debug, info, warn, error
LOG_LEVEL=debug

# 请求超时时间 (毫秒)
REQUEST_TIMEOUT=30000
